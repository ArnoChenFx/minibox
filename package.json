{
  "name": "minibox",
  "version": "0.7.0",
  "private": true,
  "description": "为 AI Agent 准备的个人开发环境：基于 Docker 的 Box 管理面板",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArnoChenFx/minibox.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "bun check --no-script",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "test:docker": "bun scripts/docker-integration.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun test",
    "check:quick": "bun run fmt:check && bun run lint && bun run typecheck && bun test --bail --changed=origin/main",
    "check:unused": "knip --include files,exports,types",
    "openapi": "bun scripts/export-openapi.ts",
    "build:cli": "bun build --compile --outfile dist/minibox src/cli.ts",
    "build:site": "bun scripts/build-site.ts",
    "preview:site": "bun run build:site && bun scripts/serve-site.ts",
    "test:site": "playwright test --config site/playwright.config.ts",
    "build:template": "docker build -t minibox-template:base --label minibox.template=true --label minibox.template.name=base --label \"minibox.template.description=Debian 12 · Node.js 26 · Python 3 · git · tmux · build-essential · non-root dev user\" templates/base",
    "check:template": "scripts/check-box-image.sh"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "ssh2": "^1.17.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@readme/openapi-parser": "^10.0.0",
    "@types/bun": "^1.4.4",
    "@types/dockerode": "^4.0.2",
    "@types/ssh2": "^1.15.6",
    "knip": "6.43.0",
    "openapi-types": "^12.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
