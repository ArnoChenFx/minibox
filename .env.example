# Copy to .env. All values are optional.
# A blank ACCESS_KEY is generated on first start into DATA_DIR/access_key (mode 600). MiniBox never writes .env.
# Use at least 20 random characters, e.g. openssl rand -hex 32. A weaker key still works, but MiniBox logs an auth.weak_key warning at startup.
ACCESS_KEY=
HOST=127.0.0.1
PORT=3920
# Direct SSH for apps such as Termius: off unless SSH_PORT is set. SSH_BIND defaults to HOST.
# SSH_PUBLIC_HOST and SSH_PUBLIC_PORT change the address that the SSH dialog shows. See docs/reference/configuration.md.
# SSH_PORT=2222
# SSH_BIND=127.0.0.1
# SSH_PUBLIC_HOST=
# SSH_PUBLIC_PORT=
DOCKER_SOCKET=/var/run/docker.sock
LABEL_PREFIX=minibox
# DATA_DIR=./data
# BASE_TEMPLATE=minibox-template:base
# STOP_TIMEOUT_SEC=3
# METRICS_INTERVAL_MS=3000
# METRICS_HISTORY=120
# Event, task and log streams open at once, across all browsers and clients. The next one is refused with 429.
# STREAM_MAX_CONNECTIONS=256
# Event log retention in days (audit, activity), command output retention in days, and the output size cap in MB.
# See Events and logs in docs/reference/configuration.md.
# EVENT_RETENTION_AUDIT_DAYS=365
# EVENT_RETENTION_ACTIVITY_DAYS=30
# EVENT_OUTPUT_RETENTION_DAYS=7
# EVENT_OUTPUT_MAX_MB=512
# LOG_LEVEL=info
# Default security profile for new boxes: standard (default), strict or relaxed. See Security profiles in docs/admin/security.md.
# BOX_PROFILE=standard
# Maximum number of processes in each new box. Existing boxes keep the limit they were created with.
# BOX_PIDS_LIMIT=1024
# OCI runtime for new boxes, such as runsc (gVisor). It must already be installed in the Docker engine.
# RUNTIME=runsc
# Keeps boxes on the default network from reaching services on the host through the bridge gateway. Boxes with network
# egress none or proxy-only are always kept off the host. 1, true, yes or on turns it on. See docs/admin/network-egress.md.
# BLOCK_HOST_GATEWAY=false
# Set TRUST_PROXY=true only behind a reverse proxy you control that overwrites X-Forwarded-For, X-Forwarded-Proto
# and X-Forwarded-Host on every request, with MiniBox reachable only through it (keep HOST=127.0.0.1).
# It makes MiniBox trust all three headers. OpenTunnel and other same-host tunnels add none of them: leave it off.
# TRUST_PROXY=false
# Public origin(s) of MiniBox when a proxy rewrites Host (nginx does by default). Comma-separated, full https:// addresses.
# Optional with OpenTunnel, which keeps Host; harmless there.
# ALLOWED_ORIGINS=https://minibox.example.com
# Base domain for subdomain port previews. Each preview then runs on <port>-<box>.<base>, with an origin of its own.
# Use a domain outside the console's domain, with a wildcard DNS record and certificate that reach MiniBox. Blank keeps
# path previews under /box/<name>/<port>/. See docs/admin/preview-subdomains.md.
# PREVIEW_BASE_DOMAIN=minibox-preview.net
# Always mark the session cookie Secure. Usually unnecessary: browsers send an https:// Origin on login, which sets it.
# Only use it over HTTPS, since browsers drop Secure cookies received over plain HTTP.
# COOKIE_SECURE=1
# How long a sign-in lasts, counted from sign-in, in days: above 0, at most 3650, fractions allowed. Sessions already
# signed in keep the lifetime they were given.
# SESSION_TTL_DAYS=30
# Optional sliding renewal: a session also ends after this many days without use. Blank leaves renewal off.
# SESSION_IDLE_DAYS=
# Seconds without input from the person before a takeover of an agent's terminal session returns it to the agent.
# Whole number from 0 to 86400; 0 keeps a takeover until it is returned by hand. See Sessions and tokens in docs/reference/configuration.md.
# SESSION_TAKEOVER_IDLE_SEC=300
# Whether the owner access key may call /mcp. Agent tokens always may. false (the default) refuses the key with 401. true
# accepts it and records each use. See docs/admin/upgrades.md.
# MCP_ALLOW_OWNER_KEY=false

# Idle auto-sleep. Global default for boxes with no per-box idleTimeoutSec. 0 disables sleep (per-box 0 also disables).
# BOX_IDLE_TIMEOUT_SEC=0
# A box is idle only when its CPU sample is below this percent (and there is no open terminal, background exec, or task).
# BOX_IDLE_CPU_PERCENT=5
# How often MiniBox checks idle sleep and TTL, in milliseconds.
# LIFECYCLE_INTERVAL_MS=30000

# Checkpoints. Automatic checkpoints kept per box, newest first, from 1 to 10000. Manual and pinned checkpoints are never removed by retention.
# CHECKPOINT_KEEP_LAST=20
# Automatic checkpoints older than this many days are removed, from 0 to 3650. 0 keeps them whatever their age.
# CHECKPOINT_KEEP_DAYS=30
# Repository size limit in MB, from 0 to 1000000000. 0 sets no limit. At the limit, new automatic checkpoints are refused, so a rollback is refused too: it takes a safety checkpoint first.
# CHECKPOINT_CAPACITY_MB=0
# Largest checkpoint package in MB, from 1 to 65536. An export above it is refused, and so is an upload. It also sets the HTTP request body cap, so raise it only for packages that need it. Packages are kept for a day.
# CHECKPOINT_PACKAGE_MAX_MB=2048
# Days the data of a deleted box or volume is kept in the recycle bin, from 1 to 365. Its entries count against CHECKPOINT_CAPACITY_MB.
# TRASH_RETENTION_DAYS=7

# Largest file uploaded to a volume in MB, from 1 to 65536. A larger upload is refused with 413 before its bytes are read. Other requests keep the 128 MB body cap.
# FILE_UPLOAD_MAX_MB=1024

# Hosts (#21). With hosts added under Settings, a box create or resize is refused when the running boxes on one host would book more CPU or memory than the host has times this ratio, from 1 to 10. 1 books no more than the host has. A single-host install is not checked.
# HOST_OVERCOMMIT=1
# Labels of the local host, as key or key=value entries separated by commas. A box create on host auto with hostLabels picks only among the hosts that carry every label it asks for. Labels set with PATCH /api/hosts/local are kept instead of these, so an old value here never undoes a change made in the console.
# HOST_LABELS=gpu,arch=amd64

# Volume usage (#119). How often each volume's usage is sampled, in seconds, from 60 to 86400. Soft limits are best effort, not a quota.
# VOLUME_USAGE_INTERVAL_SEC=600
# Free space the host disk must keep, as a percent, from 0 to 100. Below it MiniBox alerts once and refuses new volumes and checkpoints with 507 until space is freed. 0 turns the check off.
# HOST_DISK_MIN_FREE_PERCENT=10

# Notification channels (webhook, ntfy, Telegram) send only to public addresses. Set this to true to allow loopback,
# private and other non-public addresses, such as a self-hosted ntfy server or a webhook on your network.
# NOTIFY_ALLOW_PRIVATE=false
