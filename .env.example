# Copy to .env. All values are optional except that ACCESS_KEY is generated on first start if missing.
ACCESS_KEY=
HOST=127.0.0.1
PORT=3920
DOCKER_SOCKET=/var/run/docker.sock
LABEL_PREFIX=minibox
# BASE_TEMPLATE=minibox-template:base
# METRICS_INTERVAL_MS=3000
# METRICS_HISTORY=120
# LOG_LEVEL=info
# Set TRUST_PROXY=true only when a reverse proxy or tunnel you control sets X-Forwarded-For and
# X-Forwarded-Proto, and MiniBox is reachable only through it (keep HOST=127.0.0.1).
# TRUST_PROXY=false
# Public origin(s) of MiniBox when a proxy or tunnel rewrites Host. Comma-separated, full https:// addresses.
# ALLOWED_ORIGINS=https://minibox.example.com
