# Copy to .env. All values are optional except that ACCESS_KEY is generated on first start if missing.
ACCESS_KEY=
HOST=127.0.0.1
PORT=3920
DOCKER_SOCKET=/var/run/docker.sock
LABEL_PREFIX=minibox
# BASE_TEMPLATE=minibox-template:base
# METRICS_INTERVAL_MS=3000
# METRICS_HISTORY=120
# LOG_LEVEL=info
# TRUST_PROXY=false
# ALLOWED_ORIGINS=https://minibox.example.com
# Default security profile for new boxes: standard (default), strict or relaxed
# BOX_PROFILE=standard
# BOX_PIDS_LIMIT=1024
# Container runtime for new boxes, e.g. runsc for gVisor (empty = Docker's default runc)
# RUNTIME=runsc
