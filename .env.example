# Copy to .env. All values are optional.
# A blank ACCESS_KEY is generated on first start into DATA_DIR/access_key (mode 600). MiniBox never writes .env.
# Use at least 20 random characters, e.g. openssl rand -hex 32. A weaker key still works, but MiniBox logs an auth.weak_key warning at startup.
ACCESS_KEY=
HOST=127.0.0.1
PORT=3920
DOCKER_SOCKET=/var/run/docker.sock
LABEL_PREFIX=minibox
# DATA_DIR=./data
# BASE_TEMPLATE=minibox-template:base
# STOP_TIMEOUT_SEC=3
# METRICS_INTERVAL_MS=3000
# METRICS_HISTORY=120
# Event and task streams open at once, across all browsers and clients. The next one is refused with 429.
# STREAM_MAX_CONNECTIONS=256
# Event log retention in days (audit, activity), command output retention in days, and the output size cap in MB.
# See the Events section of README.md.
# EVENT_RETENTION_AUDIT_DAYS=365
# EVENT_RETENTION_ACTIVITY_DAYS=30
# EVENT_OUTPUT_RETENTION_DAYS=7
# EVENT_OUTPUT_MAX_MB=512
# LOG_LEVEL=info
# Default security profile for new boxes: standard (default), strict or relaxed. See "Security profiles" in the README.
# BOX_PROFILE=standard
# Maximum number of processes in each new box. Existing boxes keep the limit they were created with.
# BOX_PIDS_LIMIT=1024
# OCI runtime for new boxes, such as runsc (gVisor). It must already be installed in the Docker engine.
# RUNTIME=runsc
# Set TRUST_PROXY=true only behind a reverse proxy you control that overwrites X-Forwarded-For, X-Forwarded-Proto
# and X-Forwarded-Host on every request, with MiniBox reachable only through it (keep HOST=127.0.0.1).
# It makes MiniBox trust all three headers. OpenTunnel and other same-host tunnels add none of them: leave it off.
# TRUST_PROXY=false
# Public origin(s) of MiniBox when a proxy rewrites Host (nginx does by default). Comma-separated, full https:// addresses.
# Optional with OpenTunnel, which keeps Host; harmless there.
# ALLOWED_ORIGINS=https://minibox.example.com
# Always mark the session cookie Secure. Usually unnecessary: browsers send an https:// Origin on login, which sets it.
# Only use it over HTTPS, since browsers drop Secure cookies received over plain HTTP.
# COOKIE_SECURE=1
# How long a sign-in lasts, counted from sign-in, in days: above 0, at most 3650, fractions allowed. Sessions already
# signed in keep the lifetime they were given.
# SESSION_TTL_DAYS=30
# Optional sliding renewal: a session also ends after this many days without use. Blank leaves renewal off.
# SESSION_IDLE_DAYS=
