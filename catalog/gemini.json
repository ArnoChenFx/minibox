{
  "id": "gemini",
  "name": "Gemini CLI",
  "description": "Google's Gemini coding agent for the terminal.",
  "source": "npm",
  "package": "@google/gemini-cli",
  "bin": "gemini",
  "needsRoot": false,
  "estimatedMb": 150,
  "requires": "Node \u2265 20",
  "install": "npm install -g --prefix {{prefix}} {{package_spec}}",
  "upgrade": "npm install -g --prefix {{prefix}} {{package_spec}}",
  "uninstall": "npm uninstall -g --prefix {{prefix}} {{package}}",
  "detect": "command -v gemini >/dev/null && gemini --version 2>/dev/null | head -1"
}
