# 这是 .env.example 的中文版：配置项与默认值完全一致，只有注释是中文。复制为 .env 使用。所有值都是可选的。
# ACCESS_KEY 留空时，首次启动会生成一个，保存到 DATA_DIR/access_key（权限 600）。MiniBox 从不写 .env。
# 至少使用 20 个随机字符，例如 openssl rand -hex 32。较弱的密钥仍然可用，但 MiniBox 会在启动时记录 auth.weak_key 警告。
ACCESS_KEY=
HOST=127.0.0.1
PORT=3920
# 用 Termius 等应用直接走 SSH：不设置 SSH_PORT 就是关闭。SSH_BIND 默认等于 HOST。
# SSH_PUBLIC_HOST 与 SSH_PUBLIC_PORT 用来改变 SSH 对话框里显示的地址。详见 docs/reference/configuration.md（英文）。
# SSH_PORT=2222
# SSH_BIND=127.0.0.1
# SSH_PUBLIC_HOST=
# SSH_PUBLIC_PORT=
DOCKER_SOCKET=/var/run/docker.sock
LABEL_PREFIX=minibox
# DATA_DIR=./data
# 服务器存放本地备份归档的位置。默认是 DATA_DIR/backups。绝对路径按原样使用，相对路径与 DATA_DIR 一样从项目根目录解析，
# ~/ 展开为用户主目录。该目录在首次备份时创建，权限 700；位于 DATA_DIR 内的目录不会被打进备份。
# 详见 docs/zh-CN/admin/backups.md。
# BACKUP_DIR=/mnt/backups
# 本地备份保留多少个（最新的优先），每次备份成功后和启动时清理。0（默认）、留空和无效值都表示全部保留，
# 所以写错不会误删归档。异地目标从不清理。
# BACKUP_KEEP=0
# 计划备份用来加密归档的口令，因为计划任务没有人可以询问。12 到 1024 个字符，首尾不能有空格，不能换行。
# 留空时，计划任务会失败并给出提示；无效值会让启动失败。在「设置」里设置计划，或用 `minibox backup schedule set`。
# 详见 docs/zh-CN/admin/backups.md。
# BACKUP_PASSPHRASE=
# BASE_TEMPLATE=minibox-template:base
# STOP_TIMEOUT_SEC=3
# METRICS_INTERVAL_MS=3000
# METRICS_HISTORY=120
# 同时打开的事件流、任务流和日志流数量，所有浏览器和客户端合计。再多的一个会被拒绝，返回 429。
# STREAM_MAX_CONNECTIONS=256
# 事件日志（审计、活动）的保留天数、命令输出的保留天数，以及输出大小上限（MB）。
# 详见 docs/reference/configuration.md 的 Events and logs 一节（英文）。
# EVENT_RETENTION_AUDIT_DAYS=365
# EVENT_RETENTION_ACTIVITY_DAYS=30
# EVENT_OUTPUT_RETENTION_DAYS=7
# EVENT_OUTPUT_MAX_MB=512
# LOG_LEVEL=info
# 新建 Box 的默认安全档位：standard（默认）、strict 或 relaxed。详见 docs/admin/security.md 的 Security profiles 一节（英文）。
# BOX_PROFILE=standard
# 每个新建 Box 的最大进程数。已有的 Box 保持创建时的上限。
# BOX_PIDS_LIMIT=1024
# 新建 Box 使用的 OCI 运行时，例如 runsc（gVisor）。必须已经安装在 Docker 引擎里。
# RUNTIME=runsc
# 防止默认网络上的 Box 通过网桥网关访问宿主机上的服务。网络出站为 none 或 proxy-only 的 Box
# 始终不能访问宿主机，与此项无关。1、true、yes 或 on 表示开启。详见 docs/zh-CN/admin/network-egress.md。
# BLOCK_HOST_GATEWAY=false
# 只有在你控制的反向代理之后才设置 TRUST_PROXY=true：该代理对每个请求都会覆盖 X-Forwarded-For、X-Forwarded-Proto
# 和 X-Forwarded-Host，并且 MiniBox 只能经由它访问（保持 HOST=127.0.0.1）。
# 它会让 MiniBox 信任这三个头。OpenTunnel 等同机隧道不会添加其中任何一个：保持关闭。
# TRUST_PROXY=false
# 代理改写了 Host（nginx 默认会）时，MiniBox 的公开地址。用逗号分隔，写完整的 https:// 地址。
# 用 OpenTunnel 时可选，因为它保留 Host；设置了也无害。
# ALLOWED_ORIGINS=https://minibox.example.com
# 子域名端口预览的基础域名。设置后，每个预览运行在 <port>-<box>.<base> 上，拥有独立的 origin。
# 请使用控制台所在域名之外的域名，并配置能指向 MiniBox 的泛域名 DNS 记录和证书。留空则保持路径预览，
# 地址是 /box/<name>/<port>/。详见 docs/zh-CN/admin/preview-subdomains.md。
# PREVIEW_BASE_DOMAIN=minibox-preview.net
# 始终给会话 Cookie 加上 Secure。通常不必设置：登录时浏览器会发送 https:// 的 Origin，这已经会加上它。
# 只在 HTTPS 下使用，因为浏览器会丢弃通过明文 HTTP 收到的 Secure Cookie。
# COOKIE_SECURE=1
# 登录的有效期，从登录时算起，单位为天：大于 0，最多 3650，可以带小数。已经登录的会话保持签发时的有效期。
# SESSION_TTL_DAYS=30
# 可选的滑动续期：会话在连续这么多天没有使用后也会结束。留空则不启用续期。
# SESSION_IDLE_DAYS=
# 人在多少秒内没有任何输入后，对 Agent 终端会话的接管会交还给 Agent。
# 0 到 86400 的整数；0 表示接管一直保持，直到手动交还。详见 docs/reference/configuration.md 的 Sessions and tokens 一节（英文）。
# SESSION_TAKEOVER_IDLE_SEC=300
# 所有者访问密钥是否可以调用 /mcp。Agent 令牌始终可以。false（默认）会以 401 拒绝该密钥；true
# 会接受它，并记录每一次使用。详见 docs/admin/upgrades.md（英文）。
# MCP_ALLOW_OWNER_KEY=false

# 空闲自动休眠。对没有单独设置 idleTimeoutSec 的 Box 生效的全局默认值。0 表示关闭休眠（Box 自己设为 0 也表示关闭）。
# BOX_IDLE_TIMEOUT_SEC=0
# 只有当 Box 的 CPU 采样低于这个百分比（并且没有打开的终端、后台 exec 或任务）时，才算空闲。
# BOX_IDLE_CPU_PERCENT=5
# MiniBox 多久检查一次空闲休眠和 TTL，单位毫秒。
# LIFECYCLE_INTERVAL_MS=30000

# 检查点。每个 Box 保留的自动检查点数量，最新的优先，范围 1 到 10000。手动检查点和已固定的检查点永远不会被保留策略清理。
# CHECKPOINT_KEEP_LAST=20
# 超过这个天数的自动检查点会被清理，范围 0 到 3650。0 表示不论多久都保留。
# CHECKPOINT_KEEP_DAYS=30
# 仓库大小上限，单位 MB，范围 0 到 1000000000。0 表示不设上限。达到上限时，新的自动检查点会被拒绝，所以回滚也会被拒绝：回滚会先创建一个安全检查点。
# CHECKPOINT_CAPACITY_MB=0
# 检查点包的大小上限，单位 MB，范围 1 到 65536。超过它的导出会被拒绝，上传也一样。它同时决定 HTTP 请求体的上限，所以只在确实需要时才调大。检查点包保留一天。
# CHECKPOINT_PACKAGE_MAX_MB=2048
# 已删除的 Box 或卷的数据在回收站里保留的天数，范围 1 到 365。回收站里的条目计入 CHECKPOINT_CAPACITY_MB。
# TRASH_RETENTION_DAYS=7

# 上传到卷的单个文件大小上限，单位 MB，范围 1 到 65536。更大的上传会在读取任何字节之前以 413 拒绝。其他请求仍使用 128 MB 的请求体上限。
# FILE_UPLOAD_MAX_MB=1024

# 宿主机（#21）。在「设置」里添加了宿主机之后，如果某台宿主机上正在运行的 Box 预订的 CPU 或内存超过该宿主机的拥有量乘以这个比例（范围 1 到 10），创建或调整 Box 就会被拒绝。1 表示预订量不超过宿主机拥有量。只有一台宿主机的安装不做检查。
# HOST_OVERCOMMIT=1
# 本机宿主机的标签，写成 key 或 key=value，用逗号分隔。host 为 auto 并带有 hostLabels 的创建请求，只会在带有它要求的全部标签的宿主机中选择。通过 PATCH /api/hosts/local 设置的标签会取代这里的值，所以这里的旧值不会撤销你在控制台里做的修改。
# HOST_LABELS=gpu,arch=amd64

# 卷用量（#119）。每个卷的用量多久采样一次，单位秒，范围 60 到 86400。软限制是尽力而为，不是配额。
# VOLUME_USAGE_INTERVAL_SEC=600

# 出站转发。MiniBox 多久检查一次 proxy-only Box 的流量是否仍被宿主机的 FORWARD 链转发，单位秒，范围 60 到 86400。每次检查都会运行一个短暂的特权辅助容器，所以不是没有成本：首次检查在启动 30 秒后进行，proxy-only 的 Box 启动或宿主机重新上线时也会检查。没有 proxy-only Box 的宿主机完全不会被读取。MiniBox 从不自行修改宿主机的防火墙。
# EGRESS_FORWARD_CHECK_INTERVAL_SEC=600
# proxy-only Box 的代理即使遇到私有地址也可以访问的网络，写成 IPv4 地址或 CIDR 段，用逗号分隔。
# 宿主机用 Clash、Surge 或 sing-box 的 fake-IP DNS 模式时，把它设为 fake-IP 的网段，例如
# 198.18.0.0/15。不带 /n 的地址按 /32 处理，主机位会被清零，前缀必须在 8 到 32 之间，0.0.0.0/8、
# 127.0.0.0/8、169.254.0.0/16 和 224.0.0.0/3 始终被拒绝。填写一个网段，就等于让其中的每个地址都能被访问，
# 包括落在其中的云厂商元数据地址；填 10.0.0.0/8 或 192.168.0.0/16 会让 proxy-only 的 Box 能访问你的局域网。
# 详见 docs/zh-CN/admin/network-egress.md。
# EGRESS_ALLOW_RANGES=
# 宿主机磁盘必须保留的可用空间，按百分比，范围 0 到 100。低于它时 MiniBox 会告警一次，并以 507 拒绝新建卷和检查点，直到腾出空间。0 表示关闭检查。
# HOST_DISK_MIN_FREE_PERCENT=10

# 通知渠道（webhook、ntfy、Telegram）只向公网地址发送。设为 true 可允许回环、私有等非公网地址，
# 例如自建的 ntfy 服务或内网里的 webhook。
# NOTIFY_ALLOW_PRIVATE=false
